# 複製這個檔案為 .env，並填入實際的值
# cp .env.example .env

# 跟 BotFather 申請新機器人後拿到的 Token
TELEGRAM_BOT_TOKEN=

# 服務帳戶金鑰 JSON 檔案在 VPS 上的路徑
GOOGLE_SERVICE_ACCOUNT_JSON=/root/luna_bot/service_account.json

