[Unit]
Description=VVS Secretary LINE Bot
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/root/vvs-secretary
ExecStart=/root/vvs-secretary/venv/bin/gunicorn -w 1 --threads 4 -b 127.0.0.1:5000 --timeout 60 vvs_app:app
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
